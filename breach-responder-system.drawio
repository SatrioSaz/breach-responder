          <mxGeometry x="655" y="790" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Guardrails -->
        <mxCell id="guard" value="&lt;b&gt;Guardrails on every step&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Authorized folders only&lt;/b&gt; — never guesses a path or widens the search&lt;br&gt;• &lt;b&gt;Type + location, never the value&lt;/b&gt; — no card, ID, account numbers or passwords, not even the last digits&lt;br&gt;• &lt;b&gt;Read-first&lt;/b&gt; — steps 1–4 change nothing; the only change is saving the report, after approval&lt;br&gt;• &lt;b&gt;Honest results&lt;/b&gt; — completed · failed · cancelled · waiting_user · waiting_approval; empty results are valid answers; nothing is invented" style="shape=note;whiteSpace=wrap;html=1;size=16;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=20;fillColor=#fffde7;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
